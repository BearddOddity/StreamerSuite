{
  "productName": "StreamerSuite",
  "version": "0.1.0",
  "identifier": "com.streamersuite.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StreamerSuite",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https: asset: http://asset.localhost; connect-src 'self' ws: wss: https:; font-src 'self' https://fonts.gstatic.com; frame-src https://127.0.0.1:53735 http://127.0.0.1:53735",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": {
      "../widgets/": "widgets/",
      "../Config.json.template": "",
      "../public/": "public/"
    }
  }
}
